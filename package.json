{
  "name": "okf-reviewer",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "description": "Browse local OKF v0.2 bundles and record explicit human concept reviews.",
  "repository": {
    "type": "git",
    "url": "https://github.com/PMSI-AlignAlytics/okf-reviewer.git"
  },
  "homepage": "https://github.com/PMSI-AlignAlytics/okf-reviewer#readme",
  "bugs": "https://github.com/PMSI-AlignAlytics/okf-reviewer/issues",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/typescript-7/lib/tsc.js --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:ds": "node scripts/check-design-system.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "check:quiz-schema": "node scripts/generate-quiz-types.mjs --check",
    "check:version": "node scripts/check-version.mjs",
    "check:updates": "node --test scripts/release-assets.test.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "check:render-security": "node scripts/test-renderers.mjs",
    "check:rust-security": "python3 scripts/audit-rust.py",
    "clean:rust": "cargo clean",
    "version:set": "node scripts/check-version.mjs --set",
    "version:sync": "node scripts/check-version.mjs --write",
    "check:theme": "pnpm check:tokens && pnpm check:contrast && pnpm check:ds",
    "typecheck": "node node_modules/typescript-7/lib/tsc.js --noEmit",
    "test": "vitest run --project unit --project component",
    "test:watch": "vitest --project unit --project component",
    "test:integration": "vitest run --project integration",
    "test:frontend": "pnpm test && pnpm test:integration && pnpm test:stories",
    "test:stories": "vitest run --project storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "repack:deb": "node scripts/repack-deb.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2",
    "dompurify": "^3.4.16",
    "gemoji": "^8.1.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.23.0",
    "marked": "^15",
    "marked-emoji": "^2.0.3",
    "marked-footnote": "^1.4.0",
    "mermaid": "^11.17.2",
    "react": "^19",
    "react-dom": "^19",
    "shiki": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-vitest": "^10.5.2",
    "@storybook/react-vite": "^10.5.2",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/dompurify": "^3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.23",
    "axe-core": "^4.12.1",
    "babel-plugin-react-compiler": "^1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.7.0",
    "jsdom": "^25",
    "playwright": "^1.61.1",
    "storybook": "^10.5.2",
    "typescript": "^7.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  }
}
