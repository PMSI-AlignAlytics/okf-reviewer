{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "okf-review://schema/okf-quiz/v1",
  "title": "OKF knowledge quiz v1",
  "description": "Provider-neutral output contract for an evidence-bound OKF knowledge quiz.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "bundleFingerprint",
    "scopeFingerprint",
    "status",
    "title",
    "questions",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "bundleFingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "scopeFingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "insufficient-evidence"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "questions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "\\S"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "questions": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "questions": {
            "maxItems": 0
          },
          "warnings": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "heading",
        "quote"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
        },
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "criticality",
        "learningObjective",
        "prompt",
        "choices",
        "correctChoiceId",
        "explanation",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
        },
        "category": {
          "type": "string",
          "enum": [
            "decision",
            "assumption",
            "constraint",
            "architecture",
            "behaviour",
            "failure-mode",
            "change",
            "fact"
          ]
        },
        "criticality": {
          "type": "string",
          "enum": [
            "critical",
            "important",
            "supporting"
          ]
        },
        "learningObjective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "choices": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "correctChoiceId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    }
  }
}
